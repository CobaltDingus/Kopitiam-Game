  m_EditorClassIdentifier: Assembly-CSharp::CustomerManager
  customerDatabase: {fileID: 11400000, guid: 706d2a1b1db0d904c8584ee650fda5cb, type: 2}
  recipeBook: {fileID: 11400000, guid: 2c53c2b8eccd2834fa67b11a2aa0a51d, type: 2}
  trayDatabase: {fileID: 11400000, guid: e70fa4aa059bfc74e92464fc5ba0fc27, type: 2}
  customerSpriteRenderer: {fileID: 731234698}
  dialogueText: {fileID: 371707622}
  tutorialDialogue:
  - Hmmph. Hi boy. I heard from your father that you were looking for a job, and
    that maybe I could hire you to work here temporarily.
  - "I heard from your father that you are a spoiled little brat and thinks that
    it\u2019s finally time for you to experience the real world before you get too
    sheltered."
  - "Now you may be my nephew, but don\u2019t go thinking that I will go soft on
    you, I treat my employees all the same."
  - 'The only exception is your aunt, heh. '
  - Great Lets get started, make me a cup of Kopi and Kopi O.
  - 'Kopi is made of coffee,sugar, condensed milk and water. '
  - Nice work, Lets try another drink called Kopi O
  - 'Similar to Kopi, add coffee, sugar and water, Remember there is no condensed
    milk. '
  - "Alright, I\u2019ll let you serve 5 customers for today, don\u2019t mess this
    up!"
  TutorialBoss: {fileID: -6248741079362886434, guid: fb730fb58019a604f8e2223953a42332, type: 3}
  minDrinks: 1
  maxDrinks: 1
  next: {fileID: 1539991132}
