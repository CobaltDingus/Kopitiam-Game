  m_EditorClassIdentifier: '::'
  screenOverlay: {fileID: 1914570631}
  noteText: {fileID: 28570643}
  recipeViewer: {fileID: 7812042516117219409}
  dayTwoText: "Note from Uncle:  \n\nWah not bad ah you? Ok now I let you make Teh
    and Uilo. Can do?"
  dayThreeText: 'Note from Uncle:


    You know Evaporated Milk? If got someone
    ask for "C", you put Evaporated Milk. Not Condensed Milk ah. Understand? '
  dayFourText: 'Note from Uncle:


    How is your Malay ah? You know "Kosong"? If
    got someone ask for Kosong means no Sugar. I hope your brain not kosong... '
  dayFiveText: 'Note from Uncle:


    Got someone ask for "O Kosong". Got some "C
    Kosong" also. If they ask you, you can do right? '
  daySixText: "Note from Uncle: \n\nYou still here ah? Very good. You make \"Cham\"
    now can? "
  daySevenText: "Note from Uncle: \n\nYou know Hokkien? Go make \"Hor Ka Sai\" now. "
  dayEightText: "Note from Uncle: \n\nI very proud of you. Better than my other nephews.
    Now go make \"Sai Ka Hor\". "
  tehUiloRecipes:
  - {fileID: 11400000, guid: 6eb0fd95eb9be4d499c82926b3028ff2, type: 2}
  - {fileID: 11400000, guid: 26a75bf892524114c8e52d8af2437106, type: 2}
  chamRecipe: {fileID: 11400000, guid: a3811a3d226c6d747a084385dbf47392, type: 2}
